// Compass — Prisma schema
// Cluster 1 (Pay Period 1.0) data model.
// Money math: every monetary field uses integer cents (per spec — never floats).

/// Type for Goal: TRANSFER = automatic money movement (e.g. emergency
/// fund sweep, savings transfer), MILESTONE = a destination amount
/// the user is working toward (e.g. "Debt Free", "Visit Family").
/// Replaces the brittle name-pattern regex in the HorizonStrip's
/// transfer detection.
enum GoalKind {
  TRANSFER
  MILESTONE
}

/// User-facing goal category (Cluster 4.2). Separate from `kind`:
/// - `kind` (TRANSFER | MILESTONE) is the engine mechanic — how the
///   goal works (auto-sweep vs. save-up-to-target).
/// - `goalType` (EMERGENCY | INVEST) is what the goal is for. The
///   deep-links `/goals?kind=emergency` and `/goals?kind=invest` map
///   to these. The redirect from the old `/emergency` and `/invest`
///   pages lands here.
///
/// Null is allowed for custom goals (trip, purchase, anything else
/// that doesn't fit the canonical categories). The `/goals` page
/// shows an "ALL" tab by default; the kind param narrows to one
/// category.
enum GoalType {
  EMERGENCY
  INVEST
}

generator client {
  provider = "prisma-client-js"
  // Pin the client to src/generated/prisma so pnpm can resolve it
  // through our tsconfig path mapping. Without this, Prisma 7's default
  // output lives inside pnpm's virtual store and our imports break.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// The single user. Single-user assumption for v1 (D7); schema is multi-user ready.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  /// AI capability tier (D2): 0=off, 1=assistive, 2=co-pilot, 3=autonomous.
  aiTier        Int      @default(1)
  /// Routing level (D4): 0=tracking, 1=planned (L1 in v1), 2=actual (L2 future).
  routingLevel  Int      @default(1)
  /// Default saved dashboard view for this user.
  defaultViewId String?
  /// Free-form settings (theme, currency, locale, etc.) — JSON-encoded string.
  /// String instead of Json because Prisma 7's Json type uses JSONB, which SQLite
  /// doesn't support. We serialize/parse in app code (lib/json.ts) — the contract
  /// stays the same and Postgres migration in the future is trivial.
  settings      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  envelopes       Envelope[]
  transactions    Transaction[]
  paySchedules    PaySchedule[]
  goals           Goal[]
  allocationPlans AllocationPlan[]
  auditLog        AuditLog[]
  identity        FinancialIdentity?

  @@index([email])
}

/// Server-side session row. Cookie holds the session id; we look this up
/// to resolve the current user. Sessions are revocable (logout = delete
/// row) and can carry last-seen / last-ip metadata for security review.
model Session {
  id         String   @id @default(cuid())
  userId     String
  /// Hashed cookie token. We never store the raw token, so a DB leak
  /// doesn't allow session hijack.
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  /// Last-seen timestamp — refreshes on every authenticated request.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  /// Absolute expiry. Sliding sessions (extend on activity) are a future
  /// enhancement; v1 uses a fixed window so "log out everywhere" is a
  /// single `deleteMany` per user.
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Where money lives. In v1 these are "connected" via the mock flow
/// (Cluster 1 step 14). L2 routing (Plaid) is a future feature.
model Account {
  id             String   @id @default(cuid())
  userId         String
  name           String
  /// checking | savings | credit | cash | other
  type           String
  /// Current balance in cents.
  currentBalance Int      @default(0)
  institution    String?
  /// Last 4 digits of the account number, for display.
  mask           String?
  /// When L2 lands: whether the app can move money on this account.
  routingEnabled Boolean  @default(false)
  isArchived     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  paySchedules PaySchedule[]

  @@index([userId])
}

/// A vessel. The 7 default envelopes are seeded with planetary affiliation
/// (D14) so each one carries a glyph + color (visual only — never labeled in copy).
model Envelope {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  /// Target balance in cents (the cap / goal).
  targetBalance        Int      @default(0)
  /// Cached current balance. Recomputed on every transaction; kept in sync
  /// by the auto-allocate engine and the transaction write path.
  currentBalance       Int      @default(0)
  /// sol | luna | mars | mercury | jupiter | venus | saturn — null for custom envelopes.
  planet               String?
  /// Color (hex) — for non-planetary custom envelopes.
  color                String?
  /// Icon — single character or short code. Defaults to the planetary glyph.
  icon                 String?
  /// Optional destination account — the account money from this envelope "leaves to"
  /// when L1 routing is armed.
  destinationAccountId String?
  /// Hard cap behavior: 0 = soft warning, 1 = hard block (D16 enforcement).
  enforceHardCap       Boolean  @default(true)
  /// Sort order in lists.
  sortOrder            Int      @default(0)
  isArchived           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  allocationRules AllocationRule[]

  @@index([userId])
}

/// The atomic money event. Amount is signed: +income, -expense, integer cents.
/// `isPrimaMateria` is true for income transactions that trigger auto-allocate.
model Transaction {
  id             String   @id @default(cuid())
  userId         String
  accountId      String
  /// Nullable — uncategorized transactions (e.g. imported before categorization).
  envelopeId     String?
  /// Signed: +income, -expense, in cents.
  amount         Int
  date           DateTime
  payee          String
  notes          String?
  /// manual | csv | recurring | ai_suggested | routing
  source         String   @default("manual")
  /// Free-form JSON metadata (e.g. AI categorization suggestions, recurring rule id).
  metadata       String   @default("{}")
  /// True if this transaction is a paycheck that should trigger auto-allocate.
  isPrimaMateria Boolean  @default(false)
  /// Set by the auto-allocate engine to indicate which plan produced this row.
  fromPlanId     String?
  /// Set by the auto-allocate engine to indicate the paycheck row that produced this row.
  fromPaycheckId String?
  cleared        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id])
  envelope Envelope? @relation(fields: [envelopeId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([envelopeId])
  @@index([date])
  @@index([userId, date])
}

/// The user's pay schedule — cadence + which account paychecks land in.
/// Used to derive the period range and to schedule recurring paycheck detection.
model PaySchedule {
  id        String   @id @default(cuid())
  userId    String
  /// weekly | biweekly | semi_monthly | monthly
  cadence   String
  /// Default paycheck amount in cents.
  amount    Int
  /// Account paychecks land in.
  accountId String
  /// Anchor date — usually the first known paycheck.
  startDate DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([isActive])
}

/// A recurring bill (Cluster 1.8). Originally seeded in the in-memory
/// store (BILLS_SEED in src/lib/mock-seed.ts); Cluster 5.2.5 added
/// this Prisma model so the onboarding chat's expenses can project
/// into it via projection.ts. The deep pages still read from the
/// in-memory seed for now; the projection populates the table for
/// future migration. Once a widget reads from here, the BillSeed
/// entries can be migrated too.
model Bill {
  id          String    @id @default(cuid())
  userId      String
  name        String
  /// Amount per period, in cents.
  amountCents Int
  /// weekly | biweekly | semi_monthly | monthly | quarterly | annual
  cadence     String
  /// Day of month the bill is due (1-31). Null for non-monthly cadences.
  dueDay      Int?
  autopay     Boolean   @default(false)
  /// Optional ISO timestamp of the most recent payment. Null if not yet paid for the current period.
  paidAt      DateTime?
  /// Where this bill came from: "seed" (the in-memory BILLS_SEED), "identity" (projected from the chat's expenses), or "user" (manually entered in a future cluster).
  source      String    @default("seed")
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([source])
}

/// A life goal the user is working toward. The "Your Direction" section.
/// Top priority flag controls what shows in the dashboard hero.
model Goal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  description   String?
  /// Target amount in cents.
  targetAmount  Int
  /// Cached current amount in cents.
  currentAmount Int       @default(0)
  /// Optional target date.
  targetDate    DateTime?
  /// Which envelope funds this goal (e.g. "Savings" envelope → Emergency Fund goal).
  envelopeId    String?
  /// Which planet this goal is associated with — purely visual.
  planet        String?
  /// Hero priority — at most one per user (enforced in app code).
  isPrimary     Boolean   @default(false)
  /// TRANSFER = automatic money movement (e.g. emergency-fund sweep,
  /// savings transfer — surfaces in the HorizonStrip's transfer tag).
  /// MILESTONE = a destination amount the user is working toward
  /// (e.g. "Debt Free", "Visit Family"). Replaces the brittle
  /// name-pattern regex in the HorizonStrip's transfer detection.
  kind          GoalKind  @default(MILESTONE)
  /// EMERGENCY = the canonical Emergency Fund goal.
  /// INVEST = the long-horizon investment goal.
  /// Null for custom goals (trip, purchase, anything else).
  /// The /goals page filters by `?kind=emergency|invest`.
  goalType      GoalType?
  sortOrder     Int       @default(0)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPrimary])
}

/// A user's allocation plan (D11/D12). When armed, every paycheck
/// transaction triggers the rules silently — no confirm modal (D12).
model AllocationPlan {
  id         String   @id @default(cuid())
  userId     String
  /// envelope | zero_based | fifty_thirty_twenty | pay_yourself_first
  strategyId String   @default("envelope")
  /// Armed: when true, every paycheck transaction runs the rules.
  isArmed    Boolean  @default(false)
  /// Optional human-readable name ("Mom's plan").
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules AllocationRule[]

  @@index([userId])
}

/// One row per (plan, envelope) — the percentage of each paycheck that
/// gets distributed into that envelope. Sums should be ≤ 100 (remainder
/// goes to a default "buffer" or is held).
model AllocationRule {
  id         String   @id @default(cuid())
  planId     String
  envelopeId String
  /// 0–100. Integer percent.
  pct        Int
  /// Optional per-rule override: distribute a fixed amount in cents instead.
  /// If both are set, the engine uses fixedCents if set, else pct of paycheck.
  fixedCents Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  plan     AllocationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  envelope Envelope       @relation(fields: [envelopeId], references: [id])

  @@index([planId])
  @@index([envelopeId])
}

/// Every L1+ action the system takes on the user's behalf. The
/// "auto-allocate" engine writes here. The user can browse their
/// audit log in a future cluster.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  /// auto_allocate | plan_armed | plan_paused | plan_edited | envelope_created | ...
  actionType   String
  /// Free-form JSON describing what happened.
  payload      String   @default("{}")
  /// Snapshot of the user's AI tier at the time of the action.
  aiTierAtTime Int      @default(1)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Global system configuration. One row, identified by the constant
/// "GLOBAL_CONFIG". Stores cross-cutting toggles that aren't user-scoped
/// (e.g. active engine level — L1 rules vs. L2 AI). The TopAppBar's
/// engine pill reads this row to show the current state and toggles it
/// via the toggleEngineAction server action.
model SystemSettings {
  id              String   @id @default("GLOBAL_CONFIG")
  /// "L1" (deterministic rules engine) or "L2" (AI-driven). The pill
  /// on the TopAppBar surfaces this value and the engine toggle flips
  /// it between the two states.
  activeEngineLvl String   @default("L1")
  updatedAt       DateTime @updatedAt
}

/// A specific pay-period window. The TopAppBar's "CYCLE" chip reads the
/// currently-active row (the one with isActive=true) and renders the
/// `startDate ↔ endDate` range. Multi-user ready; v1 has one active row.
///
/// This is intentionally separate from `PaySchedule` (which describes the
/// recurrence cadence — weekly/biweekly/etc.). A PaySchedule can produce
/// many PayPeriod rows over time. For v1 we seed a single active period
/// that mirrors the PERIOD_START / PERIOD_END constants in lib/mock.ts.
model PayPeriod {
  id        String   @id @default(cuid())
  /// Inclusive start of the period (date only, midnight local).
  startDate DateTime
  /// Exclusive end of the period — i.e. the day AFTER the last day
  /// of the period. Stored as DateTime so partial-day math works in
  /// the future (early pay / late pay edge cases).
  endDate   DateTime
  /// True while this is the current period. Exactly one row should have
  /// isActive=true at a time; the layout helper picks the most recent.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

// ───────────────────────────────────────────────────────────────────
// Cluster 5.0 Part B — Onboarding persistence
// ───────────────────────────────────────────────────────────────────
//
// The onboarding agent (Cluster 5.0 Part A) was in-memory keyed by
// userId. Part B replaces that with a Prisma-backed FinancialIdentity
// so the conversation survives a dev server restart and the dashboard
// can later (Cluster 5.2) read the materialized identity records
// instead of the seed.
//
// The OnboardingState interface in src/lib/onboarding/state.ts is the
// public contract — its shape is unchanged between Part A and Part B.
// What changes is the storage layer: loadConversation() and
// saveConversation() now read/write these tables.

/// The user's financial identity, as built up by the onboarding agent.
/// One row per user. The scalar fields (identity basics, risk profile,
/// preferences, audit) live on this row; the array-shaped data
/// (income sources, debts, goals, etc.) lives in child tables so the
/// dashboard wire-up in Cluster 5.2 can iterate them like normal
/// queryable data.
model FinancialIdentity {
  id     String @id @default(cuid())
  userId String @unique

  // Identity basics (saveIdentityBasics)
  ageRange         String?
  employmentStatus String?
  location         String?

  // Risk profile (saveRiskProfile)
  timeHorizonYears Int?
  riskTolerance    String? // conservative | moderate | aggressive
  riskNotes        String?

  // Preferences (savePreferences)
  aiTierPref  String? // off | assistive | copilot | autonomous
  riskComfort String?
  currency    String  @default("USD")

  // Audit (buildAudit) — the closing document the agent hands back.
  auditIdentity  String?
  auditFindings  String?
  auditPlan      String?
  auditFirstStep String?
  auditTeaching  String?
  auditBuiltAt   DateTime?
  /// Set by markOnboardingComplete. Null until the conversation ends.
  completedAt    DateTime?

  // Provider telemetry — surfaces in the chat UI when the L1 rules
  // fallback fires (e.g. Mavis out of credit → mock ran the response).
  lastProvider     String? // mavis | ollama | mock
  lastFellBack     Boolean @default(false)
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes   IdentityIncome[]
  expenses  IdentityExpense[]
  debts     IdentityDebt[]
  assets    IdentityAsset[]
  goals     IdentityGoal[]
  events    IdentityEvent[]
  household IdentityHouseholdMember[]
  messages  OnboardingMessage[]

  @@index([userId])
  @@index([completedAt])
}

/// One income source. `Identity` is the namespace; the `Identity`
/// prefix keeps the cluster's tables distinct from the production
/// Account/Goal/etc. tables (which will be filled by Cluster 5.2's
/// "wire dashboard to identity" pass).
model IdentityIncome {
  id            String   @id @default(cuid())
  identityId    String
  /// "Acme Corp salary", "Social Security", etc. (saveIncomeSource.label)
  label         String
  /// weekly | biweekly | semi_monthly | monthly | irregular | null
  cadence       String?
  /// Take-home per pay period, in DOLLARS (not cents) — matches the
  /// user's mental model when they say "$1,820." The orchestrator
  /// converts to cents when it projects to the production Account
  /// /Transaction models in Cluster 5.2.
  amountDollars Int?
  /// At most one per identity is primary. The orchestrator enforces
  /// this; the DB allows multiple because partial saves (cadence
  /// known but amount pending) can land with isPrimary=true before
  /// the amount refines.
  isPrimary     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// One fixed recurring expense (rent, utilities, insurance premiums).
model IdentityExpense {
  id            String   @id @default(cuid())
  identityId    String
  /// "Rent", "Spectrum internet", "Car insurance".
  label         String
  /// Amount per period, in DOLLARS.
  amountDollars Int
  /// weekly | biweekly | semi_monthly | monthly | quarterly | annual
  cadence       String
  /// housing | utilities | insurance | food | transportation | healthcare | childcare | entertainment | other
  category      String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// One debt. APR is stored as Float because percent is naturally
/// fractional (e.g. 6.5%). Money fields stay Int.
model IdentityDebt {
  id                String   @id @default(cuid())
  identityId        String
  label             String
  /// credit_card | mortgage | student_loan | auto_loan | personal_loan | medical | other
  kind              String
  balanceDollars    Int      @default(0)
  aprPercent        Float    @default(0)
  minPaymentDollars Int      @default(0)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// One asset / account the user holds money in.
model IdentityAsset {
  id             String   @id @default(cuid())
  identityId     String
  label          String
  /// checking | savings | money_market | 401k | 403b | traditional_ira
  /// | roth_ira | taxable_brokerage | hsa | home_equity | vehicle | other
  kind           String
  balanceDollars Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// One goal. Mirrors the production `Goal` model but kept separate
/// (1) so onboarding's goals live independently until Cluster 5.2
/// projects them, and (2) so we can capture extra context the
/// production model doesn't yet store (perPaycheckDollars, kind).
model IdentityGoal {
  id                 String    @id @default(cuid())
  identityId         String
  label              String
  targetDollars      Int
  targetDate         DateTime?
  perPaycheckDollars Int?
  /// TRANSFER | MILESTONE (mirrors production GoalKind).
  kind               String
  /// EMERGENCY | INVEST | OTHER (mirrors production GoalType but
  /// also has OTHER since the agent's enum has it; production's
  /// GoalType is nullable, so we use a plain String here).
  goalType           String?
  /// 1 = top priority, 2 = next, etc. The Emergency Fund is usually 1.
  priority           Int       @default(2)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// One planned future event with a known date and cost.
model IdentityEvent {
  id                   String    @id @default(cuid())
  identityId           String
  label                String
  date                 DateTime?
  estimatedCostDollars Int       @default(0)
  isFlexible           Boolean   @default(false)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// One household member (spouse, child, dependent).
model IdentityHouseholdMember {
  id                  String   @id @default(cuid())
  identityId          String
  name                String
  /// spouse | partner | child | parent | sibling | roommate | dependent_other | other
  relationship        String
  financiallyEntwined Boolean  @default(false)
  ageRange            String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// The conversation history. One row per LLMMessage — the agent's
/// full loop reconstructs the working history by reading these in
/// `seq` order. We persist (not just cache) because the chat UI
/// (Cluster 5.1) will replay the conversation on page load, and
/// because the L1 rules fallback benefits from seeing the prior
/// tool calls when it picks up after a primary-provider failure.
model OnboardingMessage {
  id            String   @id @default(cuid())
  identityId    String
  /// user | assistant | tool
  role          String
  content       String
  /// For role="tool", the tool call id this result answers.
  toolCallId    String?
  /// For role="assistant" with toolCalls, JSON-encoded LLMToolCall[].
  toolCallsJson String?
  /// Monotonic position in the conversation per identity. 0, 1, 2, …
  /// Used to reconstruct workingHistory in loadConversation().
  seq           Int
  createdAt     DateTime @default(now())

  identity FinancialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, seq])
}

# Compass — environment contract (safe to commit)
# Copy to .env and fill in real values. Never commit .env.

# Database (Postgres)
# Local dev: docker compose -f docker-compose.dev.yml up -d
#   Note: on Windows, native PG 18 may bind 5432 — see compose
#   comments. Use the port the compose file publishes (5433 by
#   default on this project).
# Production: Neon/Supabase/RDS — same schema, same migrations.
DATABASE_URL="postgresql://compass:compass@localhost:5433/compass_dev"

# AI provider — read by the plugin registry (see src/plugins/ai).
# Allowed values: "mavis-internal" (default) | "ollama"
COMPASS_AI_PROVIDER="mavis-internal"
COMPASS_AI_MAVIS_BASE_URL="http://127.0.0.1:52100"
COMPASS_AI_MAVIS_API_KEY=""
COMPASS_AI_OLLAMA_BASE_URL="http://127.0.0.1:11434"
COMPASS_AI_OLLAMA_MODEL="llama3.1"

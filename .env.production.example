# Compass — production environment contract (template)
#
# Copy to your hosting provider's secret store (Vercel/Render/Fly env
# vars, AWS SSM, etc.) and fill in real values. Never commit the
# filled-in version.
#
# Validation: src/lib/env/prod.ts (added in Cluster Vault 4.0) refuses
# to start the app in production when this file's required keys are
# missing or look like dev placeholders (e.g. the literal "compass" /
# "compass" Postgres creds, the dev LLM provider, the MOCK signer).
#
# Cluster: Production deploy prep (2026-08-28). Postgres-everywhere.

# ── Node / framework ────────────────────────────────────────────────
# Required by Next.js to enable production-mode checks.
NODE_ENV="production"

# ── Database (Postgres) ────────────────────────────────────────────
# Any managed Postgres works: Neon, Supabase, RDS, Cloud SQL, Fly
# Postgres, etc. Same schema, same migrations (pnpm prisma migrate
# deploy) as the dev DB.
#
# Format: postgresql://USER:PASS@HOST:PORT/DB?sslmode=require
# Production Postgres requires TLS — the sslmode=require param is
# mandatory.
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/compass_prod?sslmode=require"

# ── AI: production-grade LLM (Mavis) ───────────────────────────────
# Mavis is the production-grade provider for the onboarding agent
# (extraction tier). The advisor can stay on Ollama for now — see
# LLM_PROVIDER_ADVISOR.
MAVIS_API_BASE="https://api.minimax.io/v1"
MAVIS_API_KEY="sk-..."
MAVIS_MODEL="MiniMax-M3"
MAVIS_TOOL_FORMAT="openai"

# ── AI: advisor (lighter, post-onboarding) ────────────────────────
# "ollama" (default) keeps the advisor on a local / cheap model.
# "mavis" if you want the same model as onboarding. Anything else
# in the LLM registry is also valid — see src/lib/llm/.
LLM_PROVIDER_ADVISOR="ollama"

# ── AI: smoke / fallback provider ─────────────────────────────────
# Used by integration smokes (the "l1-fallback-advisor" path) and
# any code path that explicitly requests the mock provider. Must be
# "mock" so deterministic seeds work in CI.
LLM_PROVIDER="mock"

# ── Auth / session ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="CHANGE_ME_64_BYTES_HEX"

# ── Vault (self-custodial) ────────────────────────────────────────
# Two modes, pick one for the deploy:
#
#   TESTNET  — Base Sepolia (chainId 84532). Use for staging /
#              pre-prod dry-runs. The /vault page surfaces a
#              `[WARN] Testnet` banner; the [DEPLOY] button is
#              enabled but the on-chain USDC is valueless.
#
#   MAINNET  — Base mainnet (chainId 8453). Real USDC, real gas,
#              real Safe singleton, real Aave V3 market. Cluster
#              6.0.1 wired the chain table so flipping
#              VAULT_CHAIN_ID is the only required change.
#
# All other env vars (RPC URL, Safe singleton, USDC, Aave Pool)
# are optional overrides — the canonical values for the active
# chain live in src/lib/vault/{safe-deploy,aave}.ts and will be
# used if the override is missing. Only override with caution;
# wrong addresses silently break supply/withdraw.
#
#   1. Testnet (Base Sepolia, chainId 84532)
# VAULT_CHAIN_ID="84532"
# VAULT_CHAIN_RPC_URL="https://sepolia.base.org"
# VAULT_SAFE_SINGLETON_ADDRESS="0xfb1bffC9d739B8D520DaF37dF6669fE5932EF9Aa"
# VAULT_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
# VAULT_AAVE_POOL_ADDRESS="0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27"
#
#   2. Mainnet (Base, chainId 8453)  ← Cluster 6.0.1
VAULT_CHAIN_ID="8453"
VAULT_CHAIN_RPC_URL="https://mainnet.base.org"
VAULT_SAFE_SINGLETON_ADDRESS="0x69f4D1788e39c87893C980c06EdF4b7f686e2938"
VAULT_USDC_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
VAULT_AAVE_POOL_ADDRESS="0xa238dd80c259a72e81d7e4664a9801593f98d1c5"

# The signer key MUST be a real private key, NOT the literal
# MOCK signer. prod.ts refuses to start with the MOCK value.
# Use a dedicated deployer wallet — never the user's main
# wallet. The deployer needs real ETH on Base mainnet to pay
# for the deploy + supply gas (≈$0.15 in mid-2026 conditions).
VAULT_SIGNER_KEY="0x..."

# ── Audit log retention (Cluster 7.8) ─────────────────────────────
# The live `AuditLog` table holds the last `AUDIT_LOG_RETENTION_DAYS`
# days of events. Older events are aggregated into
# `AuditLogDailyRollup` (one row per `(userId, dateKey, actionType)`
# with `count` + `failedCount`) and then deleted. Default 90.
# Lower values reduce storage + speed up the activity strip; higher
# values preserve the original event detail longer (the rollup
# stores counts only — payloads are dropped).
#
# The audit page's "Last 90 days" preset and the activity strip
# read from the live table; older days are filled from the
# rollup. Setting this lower than 90 means the 90-day chip will
# only show ~N daily bars from live rows plus the rest from the
# rollup (the read path is transparent).
#
# AUDIT_LOG_RETENTION_DAYS="90"

# ── Optional: monitoring / observability ──────────────────────────
# LOG_LEVEL=info
# SENTRY_DSN=https://...@sentry.io/...

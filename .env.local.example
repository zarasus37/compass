# Compass — local environment contract
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Do NOT commit it.
#
# This file is the contract between you and the LLM engine. The
# onboarding agent and the post-onboarding advisor both read from it
# via `src/lib/llm/config.ts`.

# ───────────────────────────────────────────────────────────────────
# LLM provider — single switch for the ONBOARDING agent
# ───────────────────────────────────────────────────────────────────
# Allowed: "mavis" | "ollama" | "mock"
#
#   mock    → no creds needed; deterministic stub (default for dev)
#   mavis   → Mavis API (production-grade, recommended for onboarding)
#   ollama  → local Ollama (works for onboarding but loses the
#             CFP-grade depth Mavis provides)
#
# This drives /api/onboarding/run. The advisor has its OWN
# provider below.
#
LLM_PROVIDER="mock"

# ───────────────────────────────────────────────────────────────────
# LLM provider — for the POST-ONBOARDING ADVISOR (Cluster 5.3.1)
# ───────────────────────────────────────────────────────────────────
# Allowed: "mavis" | "ollama" | "mock"
# Default: "ollama"
#
# The advisor uses a separate env var so you can run Mavis on the
# onboarding agent (production-grade CFP extraction) and Ollama
# on the post-onboarding advisor (smaller, local, privacy-first)
# independently. The two-tier split is the project intent — the
# advisor's value comes from smart tool use + being data-tailored,
# not from being a smarter model, so a small local model is fine.
#
# If the selected provider is misconfigured (e.g. ollama picked
# but OLLAMA_BASE unset), the advisor falls through to the L1
# mock engine on the first call rather than crashing the server.
#
LLM_PROVIDER_ADVISOR="ollama"

# ───────────────────────────────────────────────────────────────────
# Mavis — the only 4 fields you need for production-grade onboarding
# ───────────────────────────────────────────────────────────────────
# Fill these in. Leave blank to fall back to the mock.
# Set LLM_PROVIDER="mavis" above to activate.

# 1. Base URL — the OpenAI-compatible endpoint, no trailing slash
#    e.g. https://api.MiniMax.com/v1
MAVIS_API_BASE=""

# 2. API key — your Mavis / OpenAI-style key (sk-...)
MAVIS_API_KEY=""

# 3. Model name — the model id you want to drive the agent
#    e.g. Mavis-3, gpt-4o, claude-3-5-sonnet-latest
MAVIS_MODEL=""

# 4. Tool-call format — how the model surfaces tool calls.
#    Allowed: "openai" | "anthropic"
#    Defaults to "openai" if left blank (the implementation is
#    OpenAI-compatible; Anthropic support is a follow-up).
MAVIS_TOOL_FORMAT="openai"

# ───────────────────────────────────────────────────────────────────
# Ollama — local, free, private (used for the ongoing advisor)
# ───────────────────────────────────────────────────────────────────
# Run `ollama serve` and `ollama pull <model>` first. Leave blank
# to skip. Set LLM_PROVIDER="ollama" above to activate.

# Local Ollama server base (default: http://localhost:11434)
OLLAMA_BASE="http://localhost:11434"

# Ollama model tag (run `ollama list` to see what's pulled)
OLLAMA_MODEL="llama3.2"

# ───────────────────────────────────────────────────────────────────
# Database + auth (unchanged from prior clusters)
# ───────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# Mock-LLM seed — change to get a different deterministic
# conversation. Same seed = same conversation sequence.
MOCK_LLM_SEED="compass-mock-1"

# ───────────────────────────────────────────────────────────────────
# Vault — yield adapter (Phase 3.0)
# ───────────────────────────────────────────────────────────────────
# The vault's APY is sourced from the active yield adapter.
# Allowed: "mock" | "sky" | "aave"
#
#   mock    → deterministic 0.0352 (the Phase 1.0/2.0 simulation;
#            default for dev). No external dependency.
#   sky     → reads VAULT_SKY_APY (decimal, default 0.0352). The
#            Sky Savings Rate example from the spec.
#   aave    → reads VAULT_AAVE_APY (decimal, default 0.0425). The
#            Aave USDC supply rate example.
#
# In production a real cron calls the adapter and writes a
# vault.apy_refreshed audit entry. For Phase 3.0 the user
# triggers the refresh from the [SYNC] REFRESH button on
# /vault.
VAULT_YIELD_ADAPTER="mock"

# Per-adapter APY overrides. The adapter reads these on every
# call. Leave blank to use the adapter's default.
VAULT_SKY_APY=""
VAULT_AAVE_APY=""

# ───────────────────────────────────────────────────────────────────
# Vault — chain config (Cluster Vault 4.0 — Safe deployment)
# ───────────────────────────────────────────────────────────────────
# These power the live Safe deploy. Defaults target Base Sepolia
# (chainId 84532). The deploy button on /vault is only shown
# when (a) the user has a vault row AND (b) the Safe signer key
# below is set. Without the key, the deploy is a no-op.
#
# RPC URL. Public endpoint is fine for dev; rotate to Alchemy /
# Infura / QuickNode for higher rate limits.
#   Default: https://sepolia.base.org
VAULT_CHAIN_RPC_URL="https://sepolia.base.org"

# Chain id. 84532 = Base Sepolia. Used to pick the right viem
# chain object + to verify the deploy hits the intended network.
VAULT_CHAIN_ID="84532"

# The Safe's owner signer — a testnet private key Compass holds
# in env. REQUIRED for the deploy button to function. The
# signer's address is recorded on VaultAccount.signerAddress
# (the audit trail) and is the only owner of every Safe this
# server deploys (threshold = 1). Get the address some testnet
# ETH for gas from a Base Sepolia faucet (e.g. https://www.coinbase
# .com/faucets/base-ethereum-sepolia-faucet) before clicking
# [DEPLOY] or the tx will revert with insufficient funds.
#
# Generate a test-only key with:
#   node -e "console.log(require('viem/accounts').privateKeyToAccount('0x' + '1'.repeat(64)))"
# Then NEVER use the same key for anything other than the
# Compass testnet Safe.
VAULT_SAFE_SIGNER_PRIVATE_KEY=""

# Safe singleton contract address on Base Sepolia. The default
# is the canonical v1.3.0 deployment; v1.4.1 is also deployed
# but requires the Protocol Kit to use a different factory.
# Override only if you know why.
VAULT_SAFE_SINGLETON_ADDRESS="0xfb1bffC9d739B8D520DaF37dF6669fE5932EF9Aa"

# USDC contract address on Base Sepolia (Circle's official
# testnet USDC, 6 decimals). Used by the M2 funding flow and
# the M3 Aave yield integration. Not consumed in M1 (deploy
# only) but defined here so M2 doesn't have to redeploy.
VAULT_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# ───────────────────────────────────────────────────────────────────
# Vault — Aave V3 on Base Sepolia (Cluster Vault 4.0, M3)
# ───────────────────────────────────────────────────────────────────
# The M3 yield strategy. The Safe deposits USDC into Aave V3's
# USDC reserve on Base Sepolia and receives interest-bearing
# aUSDC. The [SYNC] REFRESH APY button reads the real on-chain
# currentLiquidityRate (in ray = 1e27) from the Aave V3 Pool.
#
# IMPORTANT: Aave V3 on Base Sepolia uses a different USDC than
# the M2 funding flow. M2's VAULT_USDC_ADDRESS is Circle's
# official testnet USDC; Aave's USDC reserve is the "faucet USDC"
# minted by Aave's own faucet at https://app.aave.com/faucet/.
# The Safe needs Aave-USDC to deposit. Acquire it via the faucet
# (mint to the Safe's address) before clicking [DEPOSIT].
#
# Aave V3 Pool on Base Sepolia (confirmed via Coinbase docs +
# Aave's address-book):
VAULT_AAVE_POOL_ADDRESS="0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27"

# Aave's faucet USDC on Base Sepolia (the asset the Aave Pool
# accepts). Minted by Aave's faucet. The M3 deposit flow checks
# the Safe's balance of THIS token, not the Circle USDC used
# by M2.
VAULT_AAVE_USDC_ADDRESS="0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f"

# Aave's aUSDC (the interest-bearing receipt the Safe receives
# after a successful supply). The M3 page surfaces this balance
# as the "yield-bearing balance." For Base Sepolia testnet, the
# aUSDC is also resolved dynamically from the Aave Pool's
# getReserveData(asset).aTokenAddress — this env var is a
# fallback when the dynamic read is unavailable.
VAULT_AAVE_AUSDC_ADDRESS="0x10F1A9D11cd9b7F9D46f8B6f8C5E2dF6e0c5F2a2C"

# ───────────────────────────────────────────────────────────────────
# Vault — funding cap (Cluster Vault 4.0, M2)
# ───────────────────────────────────────────────────────────────────
# The [FUND] $X USDC button on /vault refuses amounts outside this
# cap. Stored as integer cents. The default is $10,000 per
# funding call. Set higher for the closed beta if the test
# signer holds more USDC; set lower if you want to limit per-call
# risk while you're still iterating on the Aave integration.
#
#   default: 100000000  ($10,000 = 100_000_00 cents)
VAULT_FUND_MAX_CENTS="100000000"

# The M3 deposit cap. The [DEPOSIT] $X USDC button on /vault
# refuses amounts above this. The default matches M2's fund cap.
#   default: 100000000  ($10,000 = 100_000_00 cents)
VAULT_DEPOSIT_MAX_CENTS="100000000"

# Compass — local environment contract
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Do NOT commit it.
#
# This file is the contract between you and the LLM engine. The
# onboarding agent and the post-onboarding advisor both read from it
# via `src/lib/llm/config.ts`.

# ───────────────────────────────────────────────────────────────────
# LLM provider — single switch
# ───────────────────────────────────────────────────────────────────
# Allowed: "mavis" | "ollama" | "mock"
#
#   mock    → no creds needed; deterministic stub (default for dev)
#   mavis   → Mavis API (production-grade, used for onboarding)
#   ollama  → local Ollama (used for ongoing advisor post-onboarding)
#
LLM_PROVIDER="mock"

# ───────────────────────────────────────────────────────────────────
# Mavis — the only 4 fields you need for production-grade onboarding
# ───────────────────────────────────────────────────────────────────
# Fill these in. Leave blank to fall back to the mock.
# Set LLM_PROVIDER="mavis" above to activate.

# 1. Base URL — the OpenAI-compatible endpoint, no trailing slash
#    e.g. https://api.MiniMax.com/v1
MAVIS_API_BASE=""

# 2. API key — your Mavis / OpenAI-style key (sk-...)
MAVIS_API_KEY=""

# 3. Model name — the model id you want to drive the agent
#    e.g. Mavis-3, gpt-4o, claude-3-5-sonnet-latest
MAVIS_MODEL=""

# 4. Tool-call format — how the model surfaces tool calls.
#    Allowed: "openai" | "anthropic"
#    Defaults to "openai" if left blank (the implementation is
#    OpenAI-compatible; Anthropic support is a follow-up).
MAVIS_TOOL_FORMAT="openai"

# ───────────────────────────────────────────────────────────────────
# Ollama — local, free, private (used for the ongoing advisor)
# ───────────────────────────────────────────────────────────────────
# Run `ollama serve` and `ollama pull <model>` first. Leave blank
# to skip. Set LLM_PROVIDER="ollama" above to activate.

# Local Ollama server base (default: http://localhost:11434)
OLLAMA_BASE="http://localhost:11434"

# Ollama model tag (run `ollama list` to see what's pulled)
OLLAMA_MODEL="llama3.2"

# ───────────────────────────────────────────────────────────────────
# Database + auth (unchanged from prior clusters)
# ───────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# Mock-LLM seed — change to get a different deterministic
# conversation. Same seed = same conversation sequence.
MOCK_LLM_SEED="compass-mock-1"

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local signer keys. The canonical signer lives in Vercel as the Sensitive
# VAULT_SAFE_SIGNER_PRIVATE_KEY and must never be committed. `private/` is
# where a locally regenerated signer (e.g. vault_signer_new.key) is written;
# `*.key` catches the same file if it is ever generated elsewhere. Without
# these, `git add -A` would auto-stage a real key and push it to origin.
private/
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/dev.db
/dev.db-journal
/dev.db-wal
/dev.db-shm
/prisma/migrations/dev/

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db

# Logs
logs
*.log

# Local dev trash (diagnostic scripts, response dumps, dev-server logs,
# commit-message drafts, scratch files). Underscore-prefixed names are
# the convention; dot-prefixed `_…` and dot-only debug files are also
# session artifacts. Patterns are explicit (not `_*` alone) so a real
# file like `dashboard.tsx` is never accidentally caught.
_trash_*
_trash-*
_*.cjs
_*.mjs
_*.html
_*.ps1
_*.py
_*.out
_*.err
_*.log
_*.tmp
_*.txt
_*.md
scratch-*
debug-*
_dev_*
._*.cjs
._*.mjs
._*.html
._*.ps1
._*.txt
.debug-*
.diag.*
.coord-*
.audit-*
.next-pid.txt

.vercel

# Vercel staging env files (env vars not yet uploaded to Vercel
# during the runbook env-setup flow). Contains CRON_SECRET, ADMIN_*,
# MAVIS_API_KEY — must never be committed.
.vercel-*.env
# Any other .env variant is private — but the committed templates are not.
.env*
!.env.example
!.env.local.example
!.env.production.example

# Generated Prisma client. Regenerate with `pnpm db:generate`; the schema is
# the source of truth and the output is ~13 MB of build artifact.
/src/generated/
